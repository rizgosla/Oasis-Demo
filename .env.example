# Appointment form — copy to .env for local dev, and set the same keys in
# Cloudflare Pages > Settings > Environment variables for the deployed site.

# Required. Create at https://resend.com/api-keys and mark it as a secret in
# Cloudflare. Without it the form redirects to /contact?error=server.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where appointment requests are delivered.
# Defaults to oasisdentalcarehb@yahoo.com, the address published on the site.
APPOINTMENT_TO=oasisdentalcarehb@yahoo.com

# Optional. Must be on the domain verified with Resend, or delivery fails.
# Defaults to website@<the request host>.
APPOINTMENT_FROM=website@oasisdentalcarehb.com
