---
// Dentist schema — a subtype of both LocalBusiness and MedicalBusiness, so it
// carries NAP, hours and medical-practice signals in one node. Rendered site-wide
// from Layout.astro. The @id lets other schema on the site point back at it.
//
// Deliberately omitted:
//   aggregateRating / review — the 4.8 shown on the homepage comes from Google
//     and Yelp. Google requires self-serving aggregate ratings to be from reviews
//     collected on your own site; marking up third-party ratings as your own risks
//     a manual action. Google surfaces the Business Profile rating natively anyway.
//   geo — no verified coordinates available; hasMap points at the Business Profile
//     rather than guessing lat/long.
//   Saturday hours — "by appointment" is not a fixed window, and inventing one
//     would be worse than leaving it out.
//   priceRange — no source of truth for it in the site content.

import { services } from '../data/services.js';

const SITE = Astro.site?.origin ?? 'https://oasisdentalcarehb.com';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': `${SITE}/#dentist`,
  name: 'Oasis Dental Care',
  description:
    'A warm, family-run dental practice in Huntington Beach, California, led by Dr. Jason Fu — serving Orange County families for over 25 years.',
  url: SITE,
  logo: `${SITE}/logo.png`,
  image: `${SITE}/og-default.png`,
  telephone: '+1-714-893-2106',
  email: 'oasisdentalcarehb@yahoo.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6552 Bolsa Ave, Suite J',
    addressLocality: 'Huntington Beach',
    addressRegion: 'CA',
    postalCode: '92647',
    addressCountry: 'US',
  },
  hasMap: 'https://www.google.com/maps?cid=8858444920419398576',
  // Entity reconciliation for local search. Only verified profiles belong here —
  // a wrong URL merges this practice with someone else's entity.
  // No Facebook page exists for the practice, so none is listed here.
  // TODO: add the Invisalign provider listing URL once available — see
  // https://www.invisalign.com/find-my-doctor and search "Oasis Dental Care,
  // Huntington Beach" to find the practice's provider profile page.
  sameAs: [
    'https://www.google.com/maps?cid=8858444920419398576',
    'https://www.yelp.com/biz/oasis-dental-care-huntington-beach-2',
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '09:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Friday',
      opens: '09:00',
      closes: '16:00',
    },
  ],
  founder: {
    '@type': 'Person',
    name: 'Dr. Jason Fu',
    jobTitle: 'Lead Dentist & Founder',
  },
  areaServed: [
    { '@type': 'City', name: 'Huntington Beach' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
  ],
  medicalSpecialty: 'Dentistry',
  // Driven from the same data as the service pages, so each procedure now
  // carries the URL of a real page rather than a bare name.
  availableService: services.map(({ title, id }) => ({
    '@type': 'MedicalProcedure',
    name: title,
    url: `${SITE}/services/${id}`,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
