---
// Sticky bottom action bar, mobile only (see .mobile-cta in global.css).
// Distinct from the always-visible Call/Book buttons in the sticky header:
// those sit at the top out of thumb's reach on a tall phone screen, this sits
// where a thumb already is. Omitted on the contact page itself — a user
// already looking at the booking form doesn't need a bar telling them to book.
interface Props {
  page?: string;
}
const { page = '' } = Astro.props;
const TEL = 'tel:7148932106';
---

{page !== 'contact' && (
  <div class="mobile-cta" role="navigation" aria-label="Quick actions">
    <a class="btn btn-ghost" href={TEL}>Call</a>
    <a class="btn" href="/contact">Book now</a>
  </div>
)}
