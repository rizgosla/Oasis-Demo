---
import { services } from '../data/services.js';

const LOGO = '/logo.png';
const PHONE = '(714) 893-2106';
const TEL = 'tel:7148932106';

// Curated subset with short footer-specific labels, resolved against
// services.js by id so a rename or removal there drops the link instead of
// silently pointing at a dead route.
const FOOTER_SERVICES = [
  { id: 'general-dentistry', label: 'General' },
  { id: 'cosmetic-dentistry', label: 'Cosmetic' },
  { id: 'dental-implants', label: 'Implants' },
  { id: 'invisalign', label: 'Invisalign®' },
  { id: 'emergency-dentistry', label: 'Emergency' },
];
const footerServices = FOOTER_SERVICES.filter(({ id }) => services.some((s) => s.id === id));
---

<footer class="site-foot">
  <div class="wrap">
    <div class="ftop">
      <div>
        <a class="brand" href="/"><img src={LOGO} alt="Oasis Dental Care" width="1032" height="261" loading="lazy" /></a>
        <p>A warm, family-run dental practice in the heart of Huntington Beach — the same trusted dentist, serving Orange County for over 25 years.</p>
      </div>
      <div>
        <h2>Services</h2>
        <ul>
          {footerServices.map((s) => (
            <li><a href={`/services/${s.id}`}>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Practice</h2>
        <ul>
          <li><a href="/practice">Our Practice</a></li>
          <li><a href="/new-patients">New Patients</a></li>
          <li><a href="/new-patients#forms">Patient Forms</a></li>
        </ul>
      </div>
      <div>
        <h2>Visit</h2>
        <ul>
          <li>6552 Bolsa Ave, Ste J</li>
          <li>Huntington Beach, CA</li>
          <li><a href={TEL}>{PHONE}</a></li>
        </ul>
      </div>
    </div>
    <div class="fbot">
      <span>© 2026 Oasis Dental Care</span>
      <span>6552 Bolsa Ave, Suite J · Huntington Beach, CA 92647</span>
      <a href="/privacy-policy">Privacy Policy</a>
    </div>
  </div>
</footer>
