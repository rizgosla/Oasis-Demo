---
import InvisalignLogo from './InvisalignLogo.astro';
interface Props {
  sub?: string;
  href?: string;
  class?: string;
}
const {
  sub = 'Certified Provider',
  href = '/services#svc=invisalign',
  class: cls = '',
} = Astro.props;
---
<a class={`invis-badge ${cls}`.trim()} href={href} aria-label={`Invisalign ${sub}`}>
  <InvisalignLogo height={22} />
  {sub && <span class="invis-sub">{sub}</span>}
</a>
