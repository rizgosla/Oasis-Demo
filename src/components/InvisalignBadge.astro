---
interface Props {
  sub?: string;
  href?: string;
  class?: string;
}
const {
  sub = 'Certified Provider',
  href = '/services#svc=invisalign',
  class: cls = '',
} = Astro.props;
---
<a class={`invis-badge ${cls}`.trim()} href={href} aria-label={`Invisalign ${sub}`}>
  <span class="invis-mark">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 8.6c0-1.5 3.6-2.6 8-2.6s8 1.1 8 2.6v2.1c0 2.7-3 5.3-8 5.3s-8-2.6-8-5.3z" stroke="currentColor" stroke-width="1.6"/>
      <path d="M8 11v2.1M12 11.4v3M16 11v2.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <span class="invis-word">invisalign<sup>&reg;</sup></span>
  </span>
  <span class="invis-sub">{sub}</span>
</a>
