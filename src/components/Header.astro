---
import { services } from '../data/services.js';

interface Props {
  page?: string;
}

const { page = '' } = Astro.props;

const LOGO = '/logo.png';
const PHONE = '(714) 893-2106';
const TEL = 'tel:7148932106';

const nav = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'services', label: 'Services', href: '/services' },
  { key: 'about', label: 'Our Practice', href: '/practice' },
  { key: 'new-patients', label: 'New Patients', href: '/new-patients' },
  { key: 'contact', label: 'Contact', href: '/contact' },
];

const servicesDropdown = services.map(({ id, title }) => ({ id, label: title }));
---

<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/"><img src={LOGO} alt="Oasis Dental Care" width="1032" height="261" /></a>
    <nav class="nav">
      {nav.filter(n => n.key !== 'home').map(n => (
        n.key === 'services' ? (
          <div class="nav-dd">
            <a
              href={n.href}
              class={`nav-dd-trigger ${n.key === page ? 'active' : ''}`}
              aria-current={n.key === page ? 'page' : undefined}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="services-menu"
            >
              {n.label}
              <svg class="nav-dd-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            {/* Deliberately no role="menu"/"menuitem": those roles promise
                arrow-key navigation and a roving tabindex that this disclosure
                does not implement. A list of links needs no role. */}
            <div class="nav-dd-menu" id="services-menu">
              {servicesDropdown.map(s => (
                <a
                  href={`/services/${s.id}`}
                  class="nav-dd-item"
                  data-svc={s.id}
                >{s.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={n.href} class={n.key === page ? 'active' : ''} aria-current={n.key === page ? 'page' : undefined}>{n.label}</a>
        )
      ))}
    </nav>
    <div class="hcta">
      <a class="btn" href={TEL}>Call<span class="cta-more">&nbsp;Now</span></a>
      <a class="btn" href="/contact">Book<span class="cta-more">&nbsp;Now</span></a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><line class="x1" x1="4" y1="7" x2="20" y2="7"/><line class="x2" x1="4" y1="12" x2="20" y2="12"/><line class="x3" x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
    <div class="inner">
      {nav.map(n => (
        <a href={n.href} class={n.key === page ? 'active' : ''} aria-current={n.key === page ? 'page' : undefined}>{n.label} <span class="arr" aria-hidden="true">→</span></a>
      ))}
      <a href={TEL} class="phone">{PHONE} <span class="arr" aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>

<style>
  .nav-dd { position: relative; }
  .nav-dd-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .nav-dd-caret {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.18s ease;
  }
  .nav-dd:hover .nav-dd-caret,
  .nav-dd.open .nav-dd-caret {
    transform: rotate(180deg);
  }

  .nav-dd-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 240px;
    background: var(--panel, #fff);
    border: 1px solid var(--line-l, rgba(0,0,0,0.08));
    border-radius: 10px;
    padding: 6px;
    box-shadow: 0 14px 40px rgba(8, 34, 31, 0.14);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 200;
  }
  .nav-dd:hover .nav-dd-menu,
  .nav-dd:focus-within .nav-dd-menu,
  .nav-dd.open .nav-dd-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dd-item {
    font-family: var(--disp);
    font-weight: 500;
    font-size: 14px;
    color: var(--ink-soft);
    padding: 8px 12px;
    border-radius: 6px;
    white-space: nowrap;
    cursor: pointer;
  }
  .nav-dd-item:hover {
    color: var(--ink);
    background: var(--line-l, rgba(0,0,0,0.05));
  }

  @media (max-width: 1020px) {
    .nav-dd-menu { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('menuToggle');
    var menu = document.getElementById('mobileNav');
    if (btn && menu) {
      function setState(open) {
        btn.classList.toggle('open', open);
        menu.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        // The icon animates into an X, so its accessible name has to follow.
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        // Hides the fixed mobile CTA bar while open — see .mobile-cta in
        // global.css — so the two don't overlap on a short phone screen.
        document.body.classList.toggle('mobile-nav-open', open);
      }
      function close() { setState(false); }
      btn.addEventListener('click', function () {
        setState(!menu.classList.contains('open'));
      });
      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', close);
      });
      document.addEventListener('click', function (e) {
        if (!menu.classList.contains('open')) return;
        if (menu.contains(e.target) || btn.contains(e.target)) return;
        close();
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 1020) close();
      });
    }

    // Services dropdown: intercept click to open modal if already on /services
    var dd = document.querySelector('.nav-dd');
    if (dd) {
      var trigger = dd.querySelector('.nav-dd-trigger');
      if (trigger) {
        trigger.addEventListener('click', function (e) {
          // On desktop, let hover handle. On click (touch), toggle.
          if (window.innerWidth > 1020) return;
          e.preventDefault();
          dd.classList.toggle('open');
          var expanded = dd.classList.contains('open');
          trigger.setAttribute('aria-expanded', String(expanded));
        });

        // Above 1020px the flyout is opened purely by CSS :hover/:focus-within,
        // so aria-expanded has to be driven from the same events — otherwise it
        // reports "collapsed" the entire time the menu is visible.
        var setExpanded = function (v) { trigger.setAttribute('aria-expanded', String(v)); };
        dd.addEventListener('mouseenter', function () { if (window.innerWidth > 1020) setExpanded(true); });
        dd.addEventListener('mouseleave', function () { if (window.innerWidth > 1020) setExpanded(false); });
        dd.addEventListener('focusin', function () { if (window.innerWidth > 1020) setExpanded(true); });
        dd.addEventListener('focusout', function (e) {
          if (window.innerWidth > 1020 && !dd.contains(e.relatedTarget)) setExpanded(false);
        });
      }

      dd.querySelectorAll('.nav-dd-item').forEach(function (item) {
        item.addEventListener('click', function (e) {
          var id = item.getAttribute('data-svc');
          if (!id) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          // If already on /services, intercept and open modal directly
          if (window.location.pathname === '/services' || window.location.pathname === '/services/') {
            e.preventDefault();
            if (typeof window.openServiceModal === 'function') {
              window.openServiceModal(id);
              history.replaceState(null, '', '/services#svc=' + id);
            }
          }
          // Otherwise normal navigation; services.astro will read hash and open modal
        });
      });
    }
  })();
</script>
