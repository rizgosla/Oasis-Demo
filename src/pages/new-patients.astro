---
export const prerender = true;

import Layout from '../layouts/Layout.astro';

// Single source of truth for the new-patient FAQs: the <details> list below and
// the FAQPage structured data are both rendered from this array, so the visible
// copy and the markup Google reads can never drift apart.
const faqs = [
  {
    q: 'What happens during my first appointment?',
    a: "You'll meet with Dr. Fu for a conversation about your dental history, followed by an exam and any needed digital x-rays or scans. We'll review what we see together and talk about your options in clear, simple terms.",
  },
  {
    q: 'Will I get a cleaning at my first visit?',
    a: "In most cases, yes. If a different type of cleaning or treatment is needed first, we'll explain why and help you plan the next steps.",
  },
  {
    q: "What if I'm nervous about dental visits?",
    a: "You're not alone. We take your comfort seriously and go at your pace. Dr. Fu checks in often, explains each step, and adjusts treatment based on your needs.",
  },
  {
    q: 'What should I bring with me?',
    a: "Please bring a photo ID, your dental insurance card (if you have one), and any recent dental records if available. If not, no problem—we'll take care of everything here.",
  },
  {
    q: 'Does Dr. Fu explain treatment options?',
    a: 'Absolutely. Clear communication is one of our core values. We walk you through each recommendation and help you understand what is necessary, optional, or can wait.',
  },
  {
    q: 'Can I talk to Dr. Fu about past dental experiences or concerns?',
    a: 'Yes—please do. Understanding your past experiences helps us tailor your care and create a visit that feels comfortable and reassuring.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title="New Patients — Oasis Dental Care, Huntington Beach"
  description="Start your smile journey at Oasis Dental Care in Huntington Beach. Learn what to expect as a new patient and read our FAQs."
  page="new-patients"
>
<script type="application/ld+json" slot="schema" set:html={JSON.stringify(faqSchema)} />

<section class="phero">
  <div class="wrap">
    <span class="tag">/ New Patients</span>
    <h1>Start Your Smile Journey Here</h1>
    <p>Whether this is your first dental visit in years or your very first time at Oasis, we've made it easy to know what to expect — and even easier to get started.</p>
    <div class="acts">
      <a class="btn" href="/contact">Request an appointment <svg aria-hidden="true" focusable="false" class="ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="btn btn-ghost" href="tel:7148932106">Call (714) 893-2106</a>
    </div>
  </div>
</section>

<!-- Quick links bar -->
<div class="page-links">
  <div class="wrap">
    <a href="#comfort">Care &amp; Comfort</a>
    <a href="#faq">New Patient FAQ</a>
    <a href="/contact">Book Now</a>
  </div>
</div>

<!-- Care & Comfort -->
<section class="pad" id="comfort">
  <div class="wrap">
    <div class="np-split reveal">
      <div class="np-copy">
        <span class="tag">Care &amp; Comfort</span>
        <h2>A Calm, Supportive Approach</h2>

        <ul class="comfort-block">
          <li class="comfort-item">
            <div class="comfort-ic">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div>
              <strong>Dental anxiety</strong> is more common than most people realize, and it affects patients of all ages. From the moment you arrive, our goal is to create a sense of ease.
            </div>
          </li>
          <li class="comfort-item">
            <div class="comfort-ic">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 12h6M12 9v6"/></svg>
            </div>
            <div>
              <strong>Gentle techniques and modern tools</strong> matter as much as the quality of your treatment. These technologies let us show you what we see, making your treatment options easier to understand.
            </div>
          </li>
          <li class="comfort-item">
            <div class="comfort-ic">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong>You set the pace, judgement-free.</strong> Every patient has a different comfort level, and we honor that. Likewise, life gets busy. Anxiety happens. Sometimes years pass between dental visits—and that's okay. This is a place where you are welcomed—not judged.
            </div>
          </li>
        </ul>
      </div>

      <div class="np-media">
        <div class="ph-block">
          <img src="/team-edith.jpg" alt="Edith, Office Manager at Oasis Dental Care, who welcomes patients at the front desk" width="1283" height="1400" loading="lazy" />
          <div class="ovl"><span class="nm">Edith</span><span class="rl">Office Manager</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="pad np-faq-section" id="faq">
  <div class="bg-glow"></div>
  <div class="wrap">
    <div class="shead reveal">
      <div>
        <span class="tag">FAQ</span>
        <h2>Frequent Questions About New Patients</h2>
      </div>
    </div>

    <div class="np-faq-layout reveal">
      <div class="faq">
        {faqs.map(({ q, a }, i) => (
          <details open={i === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>

      <div class="np-faq-aside">
        <div class="np-aside-card">
          <div class="hd">
            <div class="grid-ov"></div>
            <h3>Ready to get started?</h3>
            <p>New patients are always welcome. Book online or give us a call.</p>
          </div>
          <div class="bd">
            <div class="row">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <span>Same-week appointments often available</span>
            </div>
            <div class="row">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
              <span>Most insurance accepted &amp; verified up front</span>
            </div>
            <div class="row">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/></svg>
              <span>ADA, CDC &amp; OSHA safety protocols</span>
            </div>
            <div class="divider"></div>
            <a class="btn" href="/contact">Request appointment</a>
            <a class="btn btn-out" href="tel:7148932106" style="justify-content:center">Call (714) 893-2106</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="wrap">
    <div class="ctacard reveal">
      <div class="grid-ov"></div>
      <div class="c">
        <span class="tag">New patients welcome</span>
        <h2>Ready when you are.</h2>
        <p>Tell us a good time and someone warm will get back to you — usually the same day.</p>
      </div>
      <div class="acts">
        <a class="btn" href="tel:7148932106">Call (714) 893-2106</a>
        <a class="btn btn-o" href="/contact">Request online</a>
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
#comfort { padding-bottom: 80px; }

/* split layout */
.np-split {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 60px;
  align-items: stretch;
}
@media(max-width: 880px) {
  .np-split { grid-template-columns: 1fr; gap: 36px; }
}
.np-copy h2 {
  font-size: clamp(28px, 3.6vw, 44px);
  margin-top: 14px;
  letter-spacing: -0.025em;
}

/* comfort items */
/* A <ul> so the three points are announced as a list; list-style:none keeps it
   looking exactly as it did when these were divs. */
.comfort-block {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 22px;
  margin-top: 28px;
}
.comfort-item {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 16px;
  align-items: start;
  padding: 20px;
  background: var(--panel);
  border: 1px solid var(--line-l);
  border-radius: 12px;
}
.comfort-item div:last-child {
  font-size: 16px;
  color: var(--ink-soft);
  line-height: 1.65;
}
.comfort-item strong {
  color: var(--ink);
}
.comfort-ic {
  width: 44px;
  height: 44px;
  border-radius: 11px;
  background: rgba(11,129,116,.08);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.comfort-ic svg {
  width: 22px;
  height: 22px;
  stroke: var(--teal);
  fill: none;
  stroke-width: 1.7;
}

/* welcome photo */
.np-media { position: relative; display: flex; flex-direction: column; }
.ph-block {
  flex: 1;
  min-height: 320px;
  border-radius: 18px;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line-l);
  background: var(--panel);
}
.ph-block img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
.ph-block .ovl {
  position: absolute;
  left: 14px;
  bottom: 14px;
  right: 14px;
  background: rgba(8,34,31,.86);
  backdrop-filter: blur(4px);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 14px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ph-block .ovl .nm { font-family: var(--disp); font-weight: 600; color: #fff; font-size: 17px; }
.ph-block .ovl .rl { font-size: 10.5px; letter-spacing: .01em; color: var(--teal-300); }

/* faq section */
.np-faq-section {
  background: var(--dark);
  color: #eaf6f3;
  position: relative;
  overflow: hidden;
}
.np-faq-section .shead h2 { color: #fff; }
.np-faq-section .tag { color: var(--teal-300); }
.np-faq-section .tag::before { background: var(--teal-300); }
.np-faq-layout {
  display: grid;
  grid-template-columns: 1.3fr .7fr;
  gap: 40px;
  margin-top: 42px;
  align-items: start;
}
.np-faq-layout .faq { margin-top: 0; }
@media(max-width: 900px) {
  .np-faq-layout { grid-template-columns: 1fr; }
}

/* faq overrides for dark bg */
.np-faq-section .faq details {
  background: var(--dark-2);
  border-color: var(--line);
}
.np-faq-section .faq summary {
  color: #eaf6f3;
}
.np-faq-section .faq p {
  color: #a9ccc5;
}
.np-faq-section .faq summary::after { color: var(--teal-300); }

/* aside card */
.np-aside-card {
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--dark-2);
  overflow: hidden;
  position: sticky;
  top: 92px;
}
.np-aside-card .hd {
  background: var(--teal-700);
  padding: 22px 24px;
  position: relative;
  overflow: hidden;
}
.np-aside-card .hd h3 {
  position: relative;
  font-size: 19px;
  color: #fff;
}
.np-aside-card .hd p {
  position: relative;
  color: #d4f3ee;
  font-size: 13.5px;
  margin-top: 6px;
}
.np-aside-card .bd {
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.np-aside-card .row {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 14.5px;
  color: #a9ccc5;
}
.np-aside-card .row svg {
  width: 18px;
  height: 18px;
  stroke: var(--teal-300);
  fill: none;
  stroke-width: 1.7;
  flex-shrink: 0;
}
.np-aside-card .divider {
  height: 1px;
  background: var(--line);
}
.np-aside-card .btn {
  justify-content: center;
  margin-top: 4px;
}
.np-aside-card .btn-out {
  background: transparent;
  color: #a9ccc5;
  border-color: var(--line);
}
.np-aside-card .btn-out:hover {
  color: #fff;
  border-color: var(--teal-300);
}

</style>
