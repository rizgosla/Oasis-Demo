---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Appointments — Oasis Dental Care, Huntington Beach"
  description="Request an appointment or reach out to Oasis Dental Care in Huntington Beach. Call (714) 893-2106 or fill out our online form."
  page="contact"
>

<section class="phero">
  <div class="wrap">
    <span class="tag">/ Contact</span>
    <h1>Let's get you in.</h1>
    <p>Request an appointment, ask a question, or tell us how we can help — someone warm will get back to you, usually the same day.</p>
  </div>
</section>

<section class="pad">
  <div class="wrap contact-grid">

    <div class="formcard reveal">
      <h2>Request an appointment</h2>
      <div class="note" id="form-note" role="status">New patients welcome. We accept most insurance plans and verify your benefits before your first visit.</div>

      <form name="appointment" method="POST" action="/api/appointment">
        <div class="frow">
          <div class="field"><label for="first_name">First name *</label><input id="first_name" type="text" name="first_name" autocomplete="given-name" placeholder="Jane" required /></div>
          <div class="field"><label for="last_name">Last name *</label><input id="last_name" type="text" name="last_name" autocomplete="family-name" placeholder="Smith" required /></div>
        </div>
        <div class="frow">
          <div class="field"><label for="email">Email *</label><input id="email" type="email" name="email" autocomplete="email" placeholder="jane@example.com" required /></div>
          <div class="field"><label for="phone">Phone</label><input id="phone" type="tel" name="phone" autocomplete="tel" placeholder="(714) 555-0000" /></div>
        </div>
        <div class="field">
          <label for="service">Service interested in</label>
          <select id="service" name="service">
            <option value="">Select a service…</option>
            <option>General / Cleaning</option>
            <option>Cosmetic</option>
            <option>Dental Implants</option>
            <option>Invisalign®</option>
            <option>Crowns &amp; Bridges</option>
            <option>Emergency</option>
            <option>Teeth Whitening</option>
            <option>Root Canal</option>
            <option>Extractions</option>
            <option>Veneers</option>
            <option>Periodontal</option>
            <option>Pediatric</option>
            <option>Not sure — need a consult</option>
          </select>
        </div>
        <div class="field"><label for="preferred_time">Preferred date / time</label><input id="preferred_time" type="text" name="preferred_time" placeholder="e.g. Mornings this week, or Fri afternoons" /></div>
        <div class="field"><label for="message">Anything else we should know?</label><textarea id="message" name="message" placeholder="How can we help?"></textarea></div>
        <label class="hp" aria-hidden="true">Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        <div style="margin-top:8px"><button type="submit" class="btn" style="width:100%;justify-content:center">Send request <svg class="ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></div>
      </form>
    </div>

    <div class="reveal" style="display:flex;flex-direction:column;gap:14px">
      <div class="infocard">
        <div class="bd">
          <h3>Visit us</h3>
          <div class="row"><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div><b>Address</b>6552 Bolsa Ave, Suite J<br />Huntington Beach, CA 92647</div></div>
          <div class="row"><svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div><b>Phone</b><a href="tel:7148932106" style="color:var(--teal)">(714) 893-2106</a></div></div>
          <div class="row"><svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><div><b>Email</b><a href="mailto:oasisdentalcarehb@yahoo.com" style="color:var(--teal)">oasisdentalcarehb@yahoo.com</a></div></div>
          <div style="margin-top:18px">
            <b style="font-size:15px">Hours</b>
            <div class="hours-list">
              <div class="hr"><span>Monday – Thursday</span><span>9:00 AM to 5:00 PM</span></div>
              <div class="hr"><span>Friday</span><span>9:00 AM to 4:00 PM</span></div>
              <div class="hr"><span>Saturday</span><span>By Appointment</span></div>
              <div class="hr c"><span>Sunday</span><span>Closed</span></div>
            </div>
          </div>
        </div>
        <div class="map"><iframe loading="lazy" title="Oasis Dental Care" src="https://maps.google.com/maps?cid=8858444920419398576&t=m&z=17&output=embed"></iframe></div>
      </div>
    </div>

  </div>
</section>


<style>
  /* Honeypot: off-screen rather than display:none, which some bots detect. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script is:inline>
  // The API route redirects back here with ?sent=1 or ?error=…; the page stays
  // prerendered, so the outcome is reported client-side in the existing note.
  (function () {
    var note = document.getElementById('form-note');
    if (!note) return;
    var params = new URLSearchParams(window.location.search);
    var message = params.has('sent')
      ? 'Thanks — your request is in. Someone from our team will get back to you, usually the same day.'
      : params.get('error') === 'invalid'
        ? 'Please check your name and email address, then send again.'
        : params.has('error')
          ? "Sorry — that didn't send. Please call us on (714) 893-2106 and we'll get you booked."
          : null;
    if (!message) return;
    note.textContent = message;
    note.scrollIntoView({ block: 'center', behavior: 'smooth' });
  })();
</script>

</Layout>
