---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Appointments — Oasis Dental Care, Huntington Beach"
  description="Request an appointment or reach out to Oasis Dental Care in Huntington Beach. Call (714) 893-2106 or fill out our online form."
  page="contact"
>

<section class="phero">
  <div class="wrap">
    <span class="tag">/ Contact</span>
    <h1>Let's get you in.</h1>
    <p>Request an appointment, ask a question, or tell us how we can help — someone warm will get back to you, usually the same day.</p>
  </div>
</section>

<section class="pad">
  <div class="wrap contact-grid">

    <div class="formcard reveal">
      <h2 id="appt-heading">Request an appointment</h2>
      <div class="note" id="form-note" role="status" aria-atomic="true">New patients welcome. We accept most insurance plans and verify your benefits before your first visit.</div>

      {/* novalidate is set from script, not here, so that without JS the browser's
          own required-field checks still apply and the server still backstops. */}
      <form name="appointment" method="POST" action="/api/appointment" aria-labelledby="appt-heading">
        <p class="form-legend">Fields marked * are required.</p>
        <div class="frow">
          <div class="field"><label for="first_name">First name *</label><input id="first_name" type="text" name="first_name" autocomplete="given-name" placeholder="Jane" required /><span class="field-error" id="first_name-error"></span></div>
          <div class="field"><label for="last_name">Last name *</label><input id="last_name" type="text" name="last_name" autocomplete="family-name" placeholder="Smith" required /><span class="field-error" id="last_name-error"></span></div>
        </div>
        <div class="frow">
          <div class="field"><label for="email">Email *</label><input id="email" type="email" name="email" autocomplete="email" placeholder="jane@example.com" required /><span class="field-error" id="email-error"></span></div>
          <div class="field"><label for="phone">Phone</label><input id="phone" type="tel" name="phone" autocomplete="tel" placeholder="(714) 555-0000" /></div>
        </div>
        <div class="field">
          <label for="service">Service interested in</label>
          <select id="service" name="service">
            <option value="">Select a service…</option>
            <option>General / Cleaning</option>
            <option>Cosmetic</option>
            <option>Dental Implants</option>
            <option>Invisalign®</option>
            <option>Crowns &amp; Bridges</option>
            <option>Emergency</option>
            <option>Teeth Whitening</option>
            <option>Root Canal</option>
            <option>Extractions</option>
            <option>Veneers</option>
            <option>Periodontal</option>
            <option>Pediatric</option>
            <option>Not sure — need a consult</option>
          </select>
        </div>
        <div class="field"><label for="preferred_time">Preferred date / time</label><input id="preferred_time" type="text" name="preferred_time" placeholder="e.g. Mornings this week, or Fri afternoons" /></div>
        <div class="field"><label for="message">Anything else we should know?</label><textarea id="message" name="message" placeholder="How can we help?"></textarea></div>
        {/* Spam trap. aria-hidden was removed deliberately: it wrapped a
            focusable input, which every automated scanner flags as
            aria-hidden-focus, and tabindex="-1" does not mitigate it because
            the field can still be focused by click or script. The off-screen
            CSS already hides it from sighted users, and bots fill any input
            they find regardless of ARIA, so the trap still works.
            The name/id/label avoid words like "company" or "website" on
            purpose — browser and password-manager autofill match those
            against saved address/business data even on off-screen fields,
            which would fill this trap for a real visitor and cause their
            genuine submission to be silently discarded as spam. */}
        <label class="hp">Leave blank<input type="text" name="hp_verify" id="hp_verify" tabindex="-1" autocomplete="off" aria-label="Leave this field blank" /></label>
        <div style="margin-top:8px"><button type="submit" class="btn" style="width:100%;justify-content:center">Send request <svg aria-hidden="true" focusable="false" class="ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></div>
      </form>
    </div>

    <div class="reveal" style="display:flex;flex-direction:column;gap:14px">
      <div class="infocard">
        <div class="bd">
          <h3>Visit us</h3>
          <div class="row"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><dl><dt>Address</dt><dd>6552 Bolsa Ave, Suite J<br />Huntington Beach, CA 92647</dd></dl></div>
          <div class="row"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><dl><dt>Phone</dt><dd><a href="tel:7148932106" style="color:var(--teal)">(714) 893-2106</a></dd></dl></div>
          <div class="row"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><dl><dt>Email</dt><dd><a href="mailto:oasisdentalcarehb@yahoo.com" style="color:var(--teal)">oasisdentalcarehb@yahoo.com</a></dd></dl></div>
          {/* "Hours" stays a <b> rather than becoming a heading so its type
              styling is untouched; the group + aria-labelledby give the same
              programmatic association a heading would. */}
          <div style="margin-top:18px" role="group" aria-labelledby="hours-heading">
            <b style="font-size:15px" id="hours-heading">Hours</b>
            <dl class="hours-list">
              <div class="hr"><dt>Monday – Thursday</dt><dd>9:00 AM to 5:00 PM</dd></div>
              <div class="hr"><dt>Friday</dt><dd>9:00 AM to 4:00 PM</dd></div>
              <div class="hr"><dt>Saturday</dt><dd>By Appointment</dd></div>
              <div class="hr c"><dt>Sunday</dt><dd>Closed</dd></div>
            </dl>
          </div>
        </div>
        <div class="map"><iframe loading="lazy" title="Map showing Oasis Dental Care at 6552 Bolsa Ave, Suite J, Huntington Beach" src="https://maps.google.com/maps?cid=8858444920419398576&t=m&z=17&output=embed"></iframe></div>
      </div>
    </div>

  </div>
</section>


<style>
  /* Honeypot: off-screen rather than display:none, which some bots detect. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    var note = document.getElementById('form-note');
    var form = document.querySelector('form[name="appointment"]');
    if (!note || !form) return;

    var LABELS = { first_name: 'first name', last_name: 'last name', email: 'email address' };
    var RULES = [
      { id: 'first_name', ok: function (v) { return v.trim() !== ''; }, msg: 'Enter your first name.' },
      { id: 'last_name', ok: function (v) { return v.trim() !== ''; }, msg: 'Enter your last name.' },
      { id: 'email', ok: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); },
        msg: 'Enter a valid email address, like jane@example.com.' }
    ];

    function showError(input, msg) {
      var err = document.getElementById(input.id + '-error');
      if (!err) return;
      input.closest('.field').classList.add('is-invalid');
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', input.id + '-error');
      err.textContent = msg;
    }

    function clearError(input) {
      var err = document.getElementById(input.id + '-error');
      if (!err) return;
      input.closest('.field').classList.remove('is-invalid');
      input.removeAttribute('aria-invalid');
      input.removeAttribute('aria-describedby');
      err.textContent = '';
    }

    // --- Client-side validation -------------------------------------------
    // Catching errors here means the user is told exactly which field is wrong
    // (3.3.1) with a correction (3.3.3), and — because the POST never happens —
    // nothing they typed is lost to the redirect.
    form.noValidate = true;

    form.addEventListener('submit', function (e) {
      var firstBad = null;
      RULES.forEach(function (r) {
        var input = document.getElementById(r.id);
        if (!input) return;
        if (r.ok(input.value)) clearError(input);
        else { showError(input, r.msg); if (!firstBad) firstBad = input; }
      });
      if (firstBad) {
        e.preventDefault();
        firstBad.focus();
      }
    });

    RULES.forEach(function (r) {
      var input = document.getElementById(r.id);
      if (!input) return;
      // Re-check on blur, but only once the field has been filled in, so a
      // user tabbing through an empty form is not scolded before they start.
      input.addEventListener('blur', function () {
        if (input.value.trim() === '') return;
        if (r.ok(input.value)) clearError(input); else showError(input, r.msg);
      });
      // Drop the message as soon as it is fixed, rather than making them submit.
      input.addEventListener('input', function () {
        if (input.hasAttribute('aria-invalid') && r.ok(input.value)) clearError(input);
      });
    });

    // --- Reporting the server's answer ------------------------------------
    // Validation also runs server-side, and without JS that is the only pass.
    // A successful submission redirects to /thank-you instead of back here, so
    // the only outcome this page ever reports is an error: ?error=invalid&fields=…
    var params = new URLSearchParams(window.location.search);
    var message = null;

    if (params.get('error') === 'invalid') {
      var bad = (params.get('fields') || '').split(',').filter(Boolean);
      bad.forEach(function (f) {
        var input = document.getElementById(f);
        var rule = RULES.filter(function (r) { return r.id === f; })[0];
        if (input && rule) showError(input, rule.msg);
      });
      message = bad.length
        ? 'Please check your ' + bad.map(function (f) { return LABELS[f] || f; }).join(', ') + ', then send again.'
        : 'Please check your name and email address, then send again.';
    } else if (params.has('error')) {
      message = "Sorry — that didn't send. Please call us on (714) 893-2106 and we'll get you booked.";
    }

    if (!message) return;
    note.textContent = message;
    // role="status" on its own is unreliable here: the text is written during
    // the first render after a full page load, usually before assistive tech
    // has finished building the page, so the change is never announced. Moving
    // focus to the note guarantees it is read — on success as well as failure.
    note.setAttribute('tabindex', '-1');
    note.focus({ preventScroll: true });
    note.scrollIntoView({ block: 'center', behavior: 'smooth' });
  })();
</script>

</Layout>
