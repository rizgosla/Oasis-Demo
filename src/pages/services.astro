---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import InvisalignBadge from '../components/InvisalignBadge.astro';
import { services } from '../data/services.js';

---

<Layout
  title="Services — Oasis Dental Care, Huntington Beach"
  description="Every dental service your family needs, all in one place in Huntington Beach. General, cosmetic, implants, Invisalign and more — with Dr. Jason Fu."
  page="services"
>

<section class="phero">
  <div class="wrap">
    <span class="tag">/ Services</span>
    <h1>Everything your<br />family needs.</h1>
    <p>From routine checkups to dental implants and Invisalign® — every service under one roof in Huntington Beach, with the same trusted dentist, Dr. Jason Fu.</p>
    <div class="acts">
      <a class="btn" href="/contact">Book a consultation <svg aria-hidden="true" focusable="false" class="ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="btn btn-ghost" href="tel:7148932106">Call (714) 893-2106</a>
    </div>
    <div style="margin-top:26px"><InvisalignBadge /></div>
  </div>
</section>

<section class="pad">
  <div class="wrap">
    <div class="cards reveal">
      {services.map((s) => (
        <a class="scell" href={`/services/${s.id}`} data-svc={s.id}>
          <div class="num">{s.num}</div>
          <div class="ic"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" set:html={s.icon} /></div>
          <h2>{s.title}</h2>
          <p>{s.cardDesc}</p>
          <span class="arr">Learn more →</span>
          <div class="bgico"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" set:html={s.bgIcon} /></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <div class="ctacard reveal">
      <div class="grid-ov"></div>
      <div class="c"><span class="tag">New patients welcome</span><h2>Not sure where to start?</h2><p>Book a consultation and Dr. Fu will walk you through the best options for your smile — no pressure.</p></div>
      <div class="acts"><a class="btn" href="tel:7148932106">Call (714) 893-2106</a><a class="btn btn-o" href="/contact">Request a consult</a></div>
    </div>
  </div>
</section>

<!-- ===== SERVICE MODAL ===== -->
{/* inert from the start: the dialog is only hidden visually when closed, so
    without it the close button and both CTAs stay in the tab order on every
    page load — and aria-hidden over focusable content is itself a violation. */}
<div id="svc-modal" aria-hidden="true" inert>
  <div class="sm-panel" role="dialog" aria-modal="true" aria-labelledby="sm-title">

    <div class="sm-header">
      <span class="tag" id="sm-category"></span>
      <button class="sm-close" id="sm-close" aria-label="Close service details">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="sm-body">
      {/* Source order is the mobile order — intro, then image + CTA, then the
          details — so the single-column layout reads the way it looks (1.3.2).
          Desktop places these into two columns explicitly in the CSS below,
          which is why there is no .sm-left wrapper any more. */}
      <div class="sm-intro">
        <h2 id="sm-title"></h2>
        <p id="sm-desc"></p>
      </div>

      <div class="sm-right">
        <div class="sm-img">
          <svg id="sm-icon" class="sm-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"></svg>
        </div>
        <div class="sm-cta">
          <a class="btn" id="sm-book-btn" href="/contact">Book a Consultation</a>
          <a class="btn btn-out sm-call" href="tel:7148932106">Call (714) 893-2106</a>
        </div>
      </div>

      <div class="sm-details">
        <ul id="sm-highlights" class="sm-hl"></ul>
        <div class="sm-faqs">
          <span class="tag">Common questions</span>
          <div class="faq" id="sm-faq-list"></div>
        </div>
      </div>
    </div>

  </div>
</div>
<!-- ===== END MODAL ===== -->

</Layout>

<style>
/* ---- modal backdrop ---- */
#svc-modal {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(8, 34, 31, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  pointer-events: none;
  transition: background 0.26s ease;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

#svc-modal.open {
  background: rgba(8, 34, 31, 0.74);
  pointer-events: all;
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
}

/* ---- modal panel ---- */
.sm-panel {
  background: var(--panel);
  border-radius: 20px;
  max-width: 900px;
  width: 100%;
  opacity: 0;
  transform: translateY(28px) scale(0.98);
  transition: opacity 0.28s ease, transform 0.28s ease;
  margin: auto;
  box-shadow: 0 24px 80px rgba(0,0,0,0.22);
  overflow: hidden;
}

#svc-modal.open .sm-panel {
  opacity: 1;
  transform: none;
}

/* ---- modal header ---- */
.sm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 28px 16px;
  position: sticky;
  top: 0;
  background: var(--panel);
  z-index: 10;
  border-bottom: 1px solid var(--line-l);
}

.sm-close {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  border: 1.5px solid var(--line-l);
  background: transparent;
  cursor: pointer;
  display: grid;
  place-items: center;
  color: var(--ink-soft);
  transition: border-color 0.16s, color 0.16s, background 0.16s;
  flex-shrink: 0;
}
.sm-close:hover { border-color: var(--ink); color: var(--ink); background: var(--bg); }
.sm-close svg {
  width: 15px; height: 15px;
  stroke: currentColor; fill: none;
  stroke-width: 2.2; stroke-linecap: round;
}

/* ---- modal body: two-column grid ---- */
.sm-body {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  /* row-gap stays 0 so .sm-details keeps its own 22px margin-top as the only
     spacing, exactly as when intro and details shared one flex wrapper. */
  column-gap: 32px;
  row-gap: 0;
  padding: 24px 28px 32px;
  align-items: start;
}

/* ---- desktop two-column placement ----
   The markup is ordered for mobile, so the desktop columns are assigned here:
   intro above details on the left, image + CTA spanning both rows on the right. */
@media (min-width: 641px) {
  .sm-intro { grid-column: 1; grid-row: 1; }
  .sm-details { grid-column: 1; grid-row: 2; }
  .sm-right { grid-column: 2; grid-row: 1 / span 2; }
}
.sm-intro, .sm-details { min-width: 0; }

.sm-intro h2 {
  font-family: var(--disp);
  font-size: clamp(22px, 2.6vw, 30px);
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 1.1;
  color: var(--ink);
  margin-top: 2px;
}

.sm-intro p {
  color: var(--ink-soft);
  font-size: 15.5px;
  margin-top: 12px;
  line-height: 1.68;
}

.sm-details { margin-top: 22px; }

.sm-hl {
  list-style: none;
  padding: 0;
  margin: 0 0 24px;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.sm-hl li {
  position: relative;
  padding-left: 28px;
  color: var(--ink-soft);
  font-size: 14.5px;
}
.sm-hl li::before {
  content: "";
  position: absolute;
  left: 0; top: 5px;
  width: 15px; height: 15px;
  border-radius: 4px;
  background: rgba(11, 129, 116, 0.11);
}
.sm-hl li::after {
  content: "";
  position: absolute;
  left: 4px; top: 9px;
  width: 6px; height: 3px;
  border-left: 1.5px solid var(--teal);
  border-bottom: 1.5px solid var(--teal);
  transform: rotate(-45deg);
}

.sm-faqs .tag { display: inline-flex; margin-bottom: 14px; }
.sm-faqs .faq { margin-top: 0; }

/* ---- right column ---- */
.sm-right {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.sm-img {
  margin: 0 !important;
  aspect-ratio: 4/3;
  background: #fff;
  border: 1px solid var(--line-l);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sm-icon {
  width: 30%;
  height: 30%;
  stroke: var(--teal);
  fill: none;
  stroke-width: 1.3;
}

.sm-cta {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.sm-cta .btn { justify-content: center; }
.sm-cta .sm-call { justify-content: center; }

/* ---- mobile ---- */
@media (max-width: 640px) {
  #svc-modal {
    padding: 0;
    align-items: flex-end;
  }

  .sm-panel {
    border-radius: 20px 20px 0 0;
    max-height: 92dvh;
    overflow-y: auto;
    transform: translateY(48px);
    margin: 0;
    width: 100%;
    max-width: 100%;
  }

  #svc-modal.open .sm-panel {
    transform: translateY(0);
  }

  .sm-header { padding: 18px 20px 14px; }

  .sm-body {
    grid-template-columns: 1fr;
    row-gap: 20px;
    padding: 18px 20px 28px;
  }
  /* No `order` overrides needed: the source order already is intro, image +
     CTA, details — which is exactly how the single column reads. */
}

@media (max-width: 400px) {
  .sm-header { padding: 16px 16px 12px; }
  .sm-body { padding: 14px 16px 24px; }
}
</style>

<script define:vars={{ services }}>
  // Build lookup map
  const SVC_MAP = {};
  services.forEach(s => { SVC_MAP[s.id] = s; });

  const backdrop = document.getElementById('svc-modal');
  const panel    = backdrop.querySelector('.sm-panel');
  const closeBtn = document.getElementById('sm-close');

  let lastFocused = null;

  function openModal(id) {
    const s = SVC_MAP[id];
    if (!s) return;

    // Populate header
    document.getElementById('sm-category').textContent = s.category;

    // Populate intro
    document.getElementById('sm-title').textContent = s.title;
    document.getElementById('sm-desc').textContent  = s.desc;

    // Populate highlights
    const hlEl = document.getElementById('sm-highlights');
    hlEl.innerHTML = s.highlights.map(h => `<li>${h}</li>`).join('');

    // Populate FAQs
    const faqEl = document.getElementById('sm-faq-list');
    faqEl.innerHTML = s.faqs.map((f, i) =>
      `<details${i === 0 ? ' open' : ''}><summary>${f.q}</summary><p>${f.a}</p></details>`
    ).join('');

    // Populate service icon
    document.getElementById('sm-icon').innerHTML = s.icon;

    // Populate CTA
    const bookBtn = document.getElementById('sm-book-btn');
    bookBtn.textContent = s.bookLabel;
    bookBtn.href = s.bookHref || '/contact';

    // Store trigger element & open
    lastFocused = document.activeElement;
    backdrop.setAttribute('aria-hidden', 'false');
    backdrop.inert = false;
    setBackgroundInert(true);
    backdrop.classList.add('open');
    document.body.style.overflow = 'hidden';

    // Move focus into modal
    requestAnimationFrame(() => closeBtn.focus());
  }

  function closeModal() {
    backdrop.classList.remove('open');
    backdrop.setAttribute('aria-hidden', 'true');
    // Closed, the dialog is only invisible — not unfocusable. inert removes it
    // from both the tab order and the accessibility tree.
    backdrop.inert = true;
    setBackgroundInert(false);
    document.body.style.overflow = '';
    if (lastFocused) lastFocused.focus();
  }

  // The Tab trap stops keyboard focus escaping, but a screen reader's virtual
  // cursor can still browse the page behind an open dialog. The ARIA dialog
  // pattern wants that content inert. The dialog lives inside <main>, so main
  // itself cannot be inerted — its other children are handled individually.
  function setBackgroundInert(on) {
    [...document.querySelectorAll('body > *'), ...document.querySelectorAll('main > *')]
      .filter(el => el.tagName !== 'SCRIPT' && el !== backdrop && !el.contains(backdrop))
      .forEach(el => { el.inert = on; });
  }

  // Expose openModal so other components (e.g., header dropdown) can trigger it
  window.openServiceModal = openModal;

  // Card clicks. Each card is a real link to /services/<id> so crawlers and
  // modified clicks (ctrl/cmd/shift/middle, "open in new tab") reach the full
  // page; a plain left click is intercepted and opens the modal as before.
  document.querySelectorAll('.scell[data-svc]').forEach(btn => {
    btn.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      openModal(btn.dataset.svc);
    });
  });

  // Open from URL hash (e.g. #svc=dental-implants), supports header dropdown links
  function openFromHash() {
    const m = /^#svc=([a-z0-9-]+)$/i.exec(window.location.hash);
    if (m && SVC_MAP[m[1]]) openModal(m[1]);
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // Close button
  closeBtn.addEventListener('click', closeModal);

  // Backdrop click (outside panel)
  backdrop.addEventListener('click', e => {
    if (e.target === backdrop) closeModal();
  });

  // ESC key
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && backdrop.classList.contains('open')) closeModal();
  });

  // Basic focus trap
  panel.addEventListener('keydown', e => {
    if (e.key !== 'Tab') return;
    const focusable = panel.querySelectorAll(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
    }
  });
</script>
