---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { services, relatedTo } from '../../data/services.js';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const related = relatedTo(service.id);

const SITE = Astro.site?.origin ?? 'https://oasisdentalcarehb.com';
const pageUrl = `${SITE}/services/${service.id}`;

const title = service.metaTitle ?? `${service.title} — Oasis Dental Care, Huntington Beach`;

// Long-form sections are optional; every service falls back to the copy it
// already carries for the card grid and modal.
const overview = service.overview ?? [service.desc];
const overviewHeading = service.overviewHeading ?? `About ${service.title.toLowerCase()}.`;
const list = service.eligibility ?? { heading: "What's included", items: service.highlights };
const asideTitle = service.asideTitle ?? 'Book your visit';
const asideRows = service.asideRows ?? [
  'Same-week appointments often available',
  'Most insurance accepted & verified up front',
  'Comfort-focused, unhurried care',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: service.title, path: `/services/${service.id}` },
  ].map(({ name, path }, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name,
    item: new URL(path, Astro.site).href,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

// Points back at the Dentist node rendered site-wide by SchemaLocalBusiness.
const procedureSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: service.title,
  description: service.desc,
  url: pageUrl,
  provider: { '@id': `${SITE}/#dentist` },
};
---

<Layout title={title} description={service.metaDescription} page="services">
<script type="application/ld+json" slot="schema" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" slot="schema" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" slot="schema" set:html={JSON.stringify(procedureSchema)} />

<section class="phero">
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a><span class="sep">/</span><a href="/services">Services</a><span class="sep">/</span><span style="color:#cfe6e2">{service.title}</span></div>
    <span class="tag">{service.category}</span>
    <h1>{service.title}</h1>
    <p>{service.heroIntro ?? service.desc}</p>
    <div class="acts">
      <a class="btn" href="/contact">Book a consultation <svg class="ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="btn btn-ghost" href="tel:7148932106">Call (714) 893-2106</a>
    </div>
  </div>
</section>

<section class="pad">
  <div class="wrap">
    <div class="split">
      <div>
        <div class="prose reveal">
          <span class="tag">Overview</span>
          <h2>{overviewHeading}</h2>
          {overview.map((para) => <p>{para}</p>)}
          <h3>{list.heading}</h3>
          <ul>
            {list.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        {service.steps && (
          <div class="prose reveal" style="margin-top:48px">
            <span class="tag">What to expect</span>
            <h2 style="margin-bottom:4px">Your treatment, step by step.</h2>
            <div class="steps">
              {service.steps.map((step) => (
                <div class="step"><div class="n"></div><div><h3>{step.title}</h3><p>{step.body}</p></div></div>
              ))}
            </div>
          </div>
        )}

        <div class="reveal" style="margin-top:48px">
          <span class="tag">Common questions</span>
          <h2 class="prose" style="margin-top:8px">Good to know.</h2>
          <div class="faq">
            {service.faqs.map(({ q, a }, i) => (
              <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
            ))}
          </div>
        </div>
      </div>

      <aside>
        <div class="scard reveal">
          <div class="hd"><div class="grid-ov"></div><h3>{asideTitle}</h3><p>Same-week appointments often available.</p></div>
          <div class="bd">
            <div class="row"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{asideRows[0]}</span></div>
            <div class="row"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg><span>{asideRows[1]}</span></div>
            <div class="row"><svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/></svg><span>{asideRows[2]}</span></div>
            <div class="divider"></div>
            <a class="btn" href={service.bookHref}>{service.bookLabel}</a>
            <a class="btn btn-out" href="tel:7148932106" style="justify-content:center">Call (714) 893-2106</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="pad" style="padding-top:0">
  <div class="wrap">
    <div class="shead reveal"><div><span class="tag">Related care</span><h2>Other ways we care for smiles.</h2></div><a class="btn btn-out" href="/services">All services</a></div>
    <div class="cards reveal">
      {related.map((r) => (
        <a class="scell" href={`/services/${r.id}`}>
          <div class="num">{r.category}</div>
          <div class="ic"><svg viewBox="0 0 24 24" set:html={r.icon} /></div>
          <h3>{r.title}</h3>
          <p>{r.cardDesc}</p>
          <span class="arr">Learn more →</span>
          <div class="bgico"><svg viewBox="0 0 24 24" set:html={r.bgIcon} /></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <div class="ctacard reveal">
      <div class="grid-ov"></div>
      <div class="c">
        <span class="tag">New patients welcome</span>
        <h2>Ready when you are.</h2>
        <p>Tell us a good time and someone warm will get back to you — usually the same day.</p>
      </div>
      <div class="acts">
        <a class="btn" href="tel:7148932106">Call (714) 893-2106</a>
        <a class="btn btn-o" href="/contact">Request online</a>
      </div>
    </div>
  </div>
</section>

</Layout>
